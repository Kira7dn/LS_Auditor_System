  "formulas": {
    "energy_supply": "E_Supply(t) = E_Solar(t) + E_Wind(t) + E_RMFC(t) + E_Grid(t)",
    "storage_soc": "SOC_Storage(t) = SOC_Storage(t-1) + eta_in * E_Surplus(t) - E_Deficit(t) / eta_out",
    "charger_balance": "sum(E_Charger_Output) * eta_charge = sum(Delta_P_kWh) + L_Transmission",
    "baseline_wtw": "GHG_Baseline_WTW = GHG_Baseline_TTW + GHG_Baseline_WTT",
    "baseline_ttw": "GHG_Baseline_TTW = D * FE_Baseline * (1 + k_empty) * Density_Diesel * NCV_Diesel * EF_Diesel_combustion / 1e9",
    "baseline_wtt": "GHG_Baseline_WTT = D * FE_Baseline * (1 + k_empty) * Density_Diesel * NCV_Diesel * EF_Diesel_WTT / 1e9",
    "project_wtw": "GHG_Project_WTW = GHG_Project_Operation + GHG_Project_EnergyProvision",
    "project_operation": "GHG_Project_Operation = 0",
    "project_energy_provision": "GHG_Project_EnergyProvision = E_Charge * (S_Grid * EF_Grid_location + S_SolarWind * EF_SolarWind_EP + S_RMFC * EF_RMFC_EP) / 1000",
    "emission_reduction": "Delta_GHG_WTW = GHG_Baseline_WTW - GHG_Project_WTW",
    "daily_energy_reconciliation": "A = vehicle_charging + unallocated_clean_energy + transmission_loss + storage_loss",
    "solar_hourly_generation_from_ninja": "E_Solar_hourly_kWh = PV_capacity_kW * ninja_pv.electricity",
    "wind_hourly_generation_from_ninja": "E_Wind_hourly_kWh = Wind_capacity_kW * ninja_wind.electricity"
  },
